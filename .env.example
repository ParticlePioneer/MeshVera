# Copy these names into your environment / workspace Secrets panel. Never commit real values.

# development | test | production
APP_ENV=development
# mock (default, no network) | live (requires the three LLM_* values below)
LLM_MODE=mock
# Provider name for live mode (adapter arrives in a later feature)
LLM_PROVIDER=
# Model name for live mode
LLM_MODEL=
# Provider secret for live mode (secret; leave empty in mock mode)
LLM_API_KEY=

# API bind address and port
API_HOST=127.0.0.1
API_PORT=8000
# Base URL the Streamlit UI uses to reach the API
API_ORIGIN=http://127.0.0.1:8000

# Worker poll interval in seconds
WORKER_POLL_SECONDS=2.0

# Per-run resource limits
MAX_NODES=50
MAX_ROUNDS=200
MAX_TRIALS=20
